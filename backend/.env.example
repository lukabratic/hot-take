# Copy to backend/.env. For docker-compose, the DATABASE_URL password must
# match the value in secrets/pg_password.txt, and the host/port must be the
# postgres/redis *service names* from docker-compose.yml, not localhost.
#
# No domain yet: FRONTEND_ORIGIN is the VPS's public IP on port 80 (default
# HTTP port, so no ":80" in the origin string). Swap for a real domain later.

DATABASE_URL=postgresql+asyncpg://hot_take:<same-password-as-secrets/pg_password.txt>@postgres:5432/hot_take
REDIS_URL=redis://redis:6379/0
CLERK_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev
CLERK_JWKS_URL=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
FRONTEND_ORIGIN=http://<vps-public-ip>
