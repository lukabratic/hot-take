# Copy to .env and fill in. Used by `docker compose build` for the frontend
# image — Vite env vars are baked in at build time, so these must be set
# *before* `docker compose up --build`, not just in backend/.env.
#
# No domain yet: use the VPS's public IP. Swap for a real domain (and put
# Caddy back in front for TLS) once you have one.

VITE_API_URL=http://<vps-public-ip>:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
